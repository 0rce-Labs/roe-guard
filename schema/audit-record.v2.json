{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0rce-Labs/roe-guard/main/schema/audit-record.v2.json",
  "title": "roe-guard audit record v2",
  "type": "object",
  "required": ["v", "seq", "chain_id", "timestamp", "engagement_id", "policy_sha256", "mode", "agent_id", "target", "action_type", "decision", "reason", "reason_code", "metadata", "prev_hash", "entry_hash"],
  "additionalProperties": false,
  "properties": {
    "v": {"const": 2},
    "seq": {"type": "integer", "minimum": 0},
    "chain_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$", "minLength": 27, "maxLength": 27},
    "engagement_id": {"type": "string", "minLength": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "mode": {"enum": ["enforce", "observe"]},
    "agent_id": {"type": "string"},
    "target": {"type": "string"},
    "action_type": {"type": "string"},
    "decision": {"enum": ["ALLOW", "DENY", "REQUIRES_APPROVAL"]},
    "reason": {"type": "string"},
    "reason_code": {"type": "string"},
    "metadata": {"type": "object"},
    "prev_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "entry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64}
  }
}
