      "input": {"kind": "action", "target": "api.x.api.example.com", "action_type": "tool.http.get", "now": "2026-10-01T10:00:00Z", "agent": null},
      "expected": {"verdict": "DENY", "reason_code": "POLICY_INVALID"}
    },
